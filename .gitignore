# ── Secrets — never commit these ────────────────────────────────────────
android/app/keystore.properties
android/local.properties
*.keystore
*.jks

# Exception: this is a fixed DEBUG-only key (not a real
# secret) committed on purpose so every CI build signs with
# the same certificate -- otherwise each build gets Gradle's
# auto-generated ephemeral key and installs can't update
# in-place over the previous build.
!android/app/debug.keystore

# ── Android / Gradle build outputs ──────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/*.iml
android/captures/
android/.cxx/
android/app/.cxx/
android/app/src/main/assets/shaders/
android/app/src/main/assets/fonts/
android/app/src/main/assets/textures/

# ── Native build artifacts ───────────────────────────────────────────────
app/res/shaders/bin/
*.o
*.spv

# ── OS / editor cruft ────────────────────────────────────────────────────
.DS_Store
*.swp
