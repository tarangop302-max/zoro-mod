<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Screen recording: MediaProjection requires a running foreground
         service of type "mediaProjection" (mandatory declaration on
         Android 14+, recommended on 10-13 too), which itself requires a
         visible notification, hence POST_NOTIFICATIONS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to launch the system install prompt for the downloaded update APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Required by AdMob for ad personalisation opt-out -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Require Vulkan 1.0 -->
    <uses-feature android:name="android.hardware.vulkan.version"
                  android:version="0x00400000"
                  android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level"
                  android:version="0"
                  android:required="true" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:label="Vlither"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:appCategory="game"
        android:isGame="true"
        android:resizeableActivity="true">

        <!-- AdMob App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9185462985805279~3500296304" />

        <!-- Opt out of AdMob data collection for GDPR safety during review -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />

        <!-- MainActivity: ad gate — this is the LAUNCHER entry point -->
        <activity
            android:name=".MainActivity"
            android:label="Vlither"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:screenOrientation="sensorLandscape"
            android:exported="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link used by the Adsterra unlock webpage to signal
                 "ad watched" back to the app: vlither://unlock -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vlither" android:host="unlock" />
            </intent-filter>
        </activity>

        <!-- GameActivity: NativeActivity subclass — launched by MainActivity -->
        <activity
            android:name=".GameActivity"
            android:label="Vlither"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:screenOrientation="sensorLandscape"
            android:immersive="true"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.game1"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

            <!-- Tell NativeActivity which .so to load -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="vlither" />
        </activity>

        <!-- GameActivity2: identical to GameActivity but runs in its own
             process (":game2"), so it gets its own independent copy of every
             native global (socket, snake/world state, Vulkan context) with
             no code changes to thermite/. A distinct taskAffinity gives it
             its own Recents entry, so it can be dragged into a floating
             pop-up / split-screen window separately from Window 1. See
             GameActivity2.kt (extends GameActivity, no logic of its own). -->
        <activity
            android:name=".GameActivity2"
            android:process=":game2"
            android:label="Vlither (Window 2)"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:screenOrientation="sensorLandscape"
            android:immersive="true"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.game2"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

            <meta-data
                android:name="android.app.lib_name"
                android:value="vlither" />
        </activity>

        <!-- GameActivity3/4/5: same pattern as GameActivity2 — own process,
             own taskAffinity, own Recents entry, no native code changes. -->
        <activity
            android:name=".GameActivity3"
            android:process=":game3"
            android:label="Vlither (Window 3)"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:screenOrientation="sensorLandscape"
            android:immersive="true"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.game3"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

            <meta-data
                android:name="android.app.lib_name"
                android:value="vlither" />
        </activity>

        <activity
            android:name=".GameActivity4"
            android:process=":game4"
            android:label="Vlither (Window 4)"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:screenOrientation="sensorLandscape"
            android:immersive="true"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.game4"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

            <meta-data
                android:name="android.app.lib_name"
                android:value="vlither" />
        </activity>

        <activity
            android:name=".GameActivity5"
            android:process=":game5"
            android:label="Vlither (Window 5)"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation"
            android:screenOrientation="sensorLandscape"
            android:immersive="true"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="${applicationId}.game5"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

            <meta-data
                android:name="android.app.lib_name"
                android:value="vlither" />
        </activity>

        <!-- Foreground service required by MediaProjection while a screen
             recording is in progress (mandatory android:foregroundServiceType
             on Android 14+, expected on 10-13 too). Runs only for the
             duration of a recording, started right before, stopped right
             after. See ScreenRecordService.kt / GameActivity.kt. -->
        <service
            android:name=".ScreenRecordService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Lets the phone's own video player open a recorded clip
             (see GameActivity.kt's playClip()) without exposing the
             app's whole private storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
