<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Screen recording: MediaProjection requires a running foreground
         service of type "mediaProjection" (mandatory declaration on
         Android 14+, recommended on 10-13 too), which itself requires a
         visible notification, hence POST_NOTIFICATIONS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Background play: a live run keeps going with the app in the
         background / screen off, only while the run lasts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Needed to launch the system install prompt for the downloaded update APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Required by AdMob for ad personalisation opt-out -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Require Vulkan 1.0 -->
    <uses-feature android:name="android.hardware.vulkan.version"
                  android:version="0x00400000"
                  android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level"
                  android:version="0"
                  android:required="true" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:label="JSR Vlither"
        android:hasCode="true"
        android:extractNativeLibs="true"